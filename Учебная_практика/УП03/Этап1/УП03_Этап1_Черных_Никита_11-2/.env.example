# ============================================================
#  Office Jerk 2D — пример переменных окружения (.env.example)
# ============================================================
# ВАЖНО: сама игра НЕ требует ни одной переменной окружения —
# это десктопный Godot-проект без БД, без сервера и без сети.
# Чтобы запустить игру, файл .env НЕ нужен.
#
# Переменные ниже относятся ТОЛЬКО к вспомогательным dev-скриптам
# генерации спрайтов (scripts/asset_gen.py, gemini_gen.py,
# gemini_web.py). Они нужны разработчику, а не игроку.
#
# Скопируйте этот файл в .env и подставьте свои значения:
#     cp .env.example .env          (Linux/macOS)
#     copy .env.example .env        (Windows cmd)
# Файл .env уже добавлен в .gitignore и НЕ должен попадать в репозиторий.
# ============================================================

# Ключ Google Gemini API для генерации пиксель-спрайтов офисных
# объектов через scripts/asset_gen.py. Получить: https://aistudio.google.com/apikey
# НИКОГДА не коммитить реальный ключ в git.
GEMINI_API_KEY=your_google_gemini_api_key_here

# Модель генерации изображений (необязательно, есть значение по умолчанию).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Папка с пользовательской сессией Chrome для gemini_web.py
# (автоматизация gemini.google.com через Playwright). Путь, не секрет.
GEMINI_SESSION_DIR=./.gemini_session
