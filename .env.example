# ============================================================
#  Office Jerk 2D — пример переменных окружения (.env.example)
# ============================================================
# Сама игра НЕ требует .env: это десктопный Godot-проект без БД,
# сервера и сети. Файл нужен только вспомогательным dev-скриптам
# генерации спрайтов (scripts/asset_gen.py и др.).
#
# Скопируйте в .env и подставьте свои значения:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux/macOS)
# Настоящий .env в репозиторий НЕ коммитится (см. .gitignore).
# ============================================================

# Ключ Google Gemini API для генерации пиксель-спрайтов.
# Получить: https://aistudio.google.com/apikey  — НЕ коммитить реальный ключ.
GEMINI_API_KEY=your_google_gemini_api_key_here

# Модель генерации изображений (необязательно).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Папка сессии Chrome для gemini_web.py (путь, не секрет).
GEMINI_SESSION_DIR=./.gemini_session

# Путь к Godot для BAT/Makefile (необязательно; по умолчанию ищется в PATH).
# GODOT=C:\Tools\Godot\Godot_v4.6.1-stable_win64.exe
